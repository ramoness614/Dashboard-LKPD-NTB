# ============================================================================
# InsForge backend — environment variables
# Copy to .env.local (frontend/CLI both read their own; see notes).
# Get values after `npx @insforge/cli link`:
#   oss_host -> .insforge/project.json
#   ANON_KEY -> npx @insforge/cli secrets get ANON_KEY
# ============================================================================

# --- Public (safe for browser; also mirrored in insforge-config.js) ---
INSFORGE_URL=https://your-app.us-east.insforge.app
INSFORGE_ANON_KEY=eyJhbGciOi...

# --- Server-only secrets (set via `npx @insforge/cli secrets add <NAME> <VALUE>`) ---
# Admin/service key used by edge functions to write past RLS:
INSFORGE_API_KEY=ifk_...
# Base URL the edge functions read at runtime:
INSFORGE_BASE_URL=https://your-app.us-east.insforge.app
# OpenRouter for AI recommendations (optional; rule-based fallback if absent):
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
